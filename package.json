{
  "name": "records-requests",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run validate:cloudflare && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "npm run validate:cloudflare && opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "validate:cloudflare": "node scripts/validate-cloudflare-config.mjs",
    "lint": "next lint"
  },
  "dependencies": {
    "@mailmypdf/pricing": "https://github.com/mycomind4-arch/mailmypdf-platform/releases/download/pricing-v0.2.2/mailmypdf-pricing-0.2.1.tgz",
    "@mailmypdf/runtime": "https://github.com/mycomind4-arch/mailmypdf-platform/releases/download/runtime-v0.1.0/mailmypdf-runtime-0.1.0.tgz",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.507.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.126.0"
  }
}
